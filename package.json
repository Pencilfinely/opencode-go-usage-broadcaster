{
  "name": "opencode-go-usage-broadcaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "auth:setup": "tsx scripts/auth-setup.ts",
    "test:auth": "tsx --test scripts/auth-setup.test-node.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run test:auth",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@types/node": "24.13.3",
    "playwright-core": "1.62.1",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  },
  "dependencies": {
    "acorn": "8.18.0"
  }
}
