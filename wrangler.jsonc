{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opencode-go-usage-broadcaster",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opencode-go-usage",
      "database_id": "3759034b-ac92-45ed-a315-f33bd1d7ac92",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 1-15 * * *"]
  },
  "vars": {
    "USAGE_SOURCE": "opencode-console",
    "USAGE_FIXTURE_JSON": "{\"rollingUsage\":{\"status\":\"ok\",\"resetInSec\":3600,\"usagePercent\":49},\"weeklyUsage\":{\"status\":\"ok\",\"resetInSec\":259200,\"usagePercent\":20},\"monthlyUsage\":{\"status\":\"ok\",\"resetInSec\":1209600,\"usagePercent\":10}}",
    "OPENCODE_CONSOLE_ENABLED": "true",
    "OPENCODE_AUTH_GENERATION": "1",
    "PUBLIC_BASE_URL": "https://opencode-go-usage-broadcaster.opencode-go-usage-broadcaster.workers.dev"
  },
  "secrets": {
    "required": [
      "PUSHPLUS_TOKEN",
      "PUSHPLUS_TOPIC",
      "PUSHPLUS_CALLBACK_SECRET",
      "PUSHPLUS_CALLBACK_BASE_URL",
      "MANUAL_TRIGGER_SECRET",
      "OPENCODE_SESSION_BUNDLE",
      "USAGE_CHART_SIGNING_SECRET"
    ]
  }
}
